# third-party clones and built binaries (re-create with deploy/README.md)
vendor/
# simulator / wallet runtime data
.sim/
*.db
*.log
# node
node_modules/
# TELA host serving clones (runtime data)
datashards/
# secrets and local chain state (added 2026-09-06 after the tooling audit)
.testnet/
.mainnet/
*.seed
*.db.bak
dist/
**/target/
research/crosschain/poc/sim-foreign.json

# keep the measured evidence the research cites (logs are otherwise ignored)
!research/**/*.log

# upstream research clones (read-only references; re-clone by URL, see research/crosschain/SOURCES.md)
research/farcaster-core/
research/frost/
research/mycelium/
research/xmr-btc-swap/

# signer daemon local state: vote memory and release intents, one file per signer per vault. Signer state is
# never tracked, wherever it was written (testnet/signer-*.json was, and named a vault that no longer exists).
tools/vaultsigner-*.json
signer-*.json
# the Monero swap companion's own files (tools/xmrswap/cmd/xmrswap): its state holds this party's key share in
# plaintext (-state, default <role>.json), then its lock file, the used-secret register and the rendezvous
# directory (-channel, default ./swap-channel). Monero wallet key files, should a wallet-dir land in the tree.
bob.json
alice.json
*.json.lock
xmrswap-used.json
swap-channel/
*.keys
# the Zcash swap companion's own files (tools/zecswap): the maker's state holds the swap secret s and the taker's
# holds her refund; the used-hash register; pre-signed refund transactions (GAP-028)
maker.json
taker.json
zecswap-used.json
*.refund.txt
# built binaries
tools/*.exe
research/crosschain/poc/sim-*.json
