+		globals.Config.Genesis_Block_Hash = gb.GetHash()
+		fmt.Printf("private testnet genesis in use: block hash %s\n", config.Testnet.Genesis_Block_Hash)
+	}
+
 	logger.V(0).Info("", "MODE", globals.Config.Name)
 	logger.V(0).Info("", "Daemon data directory", globals.GetDataDirectory())
 
