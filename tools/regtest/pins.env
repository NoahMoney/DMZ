# Pinned artifacts and ports of the DMZ regtest harness. Sourced by common.sh; every script refuses a binary whose
# sha256 is not the one here. PINS.md records where each value came from and how its signature was verified.

# --- Monero: official CLI release, linux-x64 build (run inside WSL2; see README.md "Why WSL") ---
MONERO_VERSION=0.18.5.1
MONERO_TARBALL=monero-linux-x64-v0.18.5.1.tar.bz2
MONERO_TARBALL_URL=https://downloads.getmonero.org/cli/monero-linux-x64-v0.18.5.1.tar.bz2
MONERO_TARBALL_SHA256=22a7dda7b0cb699fdd6b7674c3b4a4465b337cc98a54983523b759e1e7cc9958
# the two binaries as extracted from that tarball
MONEROD_SHA256=9b3b2676ea7868c1a7186feea9569c2cf7683ae79d2fcc769c846a91c810a1f5
MONERO_WALLET_RPC_SHA256=c1e3aff7c72837e6f29045c439b772a82b5cd7324c8b831fa825a6ce2019a656
# the signed hash list and the key that signs it (binaryFate, from monero-project/monero utils/gpg_keys/)
MONERO_HASHES_URL=https://www.getmonero.org/downloads/hashes.txt
MONERO_HASHES_SHA256=6d302c2becbd529822e8f6ef422e3f7a42045f8386e85251dbbf4b1e913266c4
MONERO_SIGNER_KEY_URL=https://raw.githubusercontent.com/monero-project/monero/master/utils/gpg_keys/binaryfate.asc
MONERO_SIGNER_FPR=81AC591FE9C4B65C5806AFC3F0AF4D462A0BDF92

# --- Zcash: zebrad, the Zcash Foundation's release binary (run inside WSL2) ---
ZEBRA_VERSION=6.3.0
ZEBRA_TARBALL=zebrad-6.3.0-x86_64-unknown-linux-gnu.tar.gz
ZEBRA_TARBALL_URL=https://github.com/ZcashFoundation/zebra/releases/download/v6.3.0/zebrad-6.3.0-x86_64-unknown-linux-gnu.tar.gz
ZEBRA_TARBALL_SHA256=86326f5324f4e59cc2008c15f94407cc8d5feacf75d64942164bb5f08eca8c5e
ZEBRAD_SHA256=5e74b3b0fae286394e9c0ddd70d2014360816fdebf01b39dd3e3a6691d6a6e63
# SHA256SUMS is signed keylessly with sigstore by the release workflow below
ZEBRA_SUMS_URL=https://github.com/ZcashFoundation/zebra/releases/download/v6.3.0/SHA256SUMS
ZEBRA_SUMS_SHA256=3eb5de0634f637e793d0411b6c7108802a36e1219f9151803ecc6108fd0f59f6
ZEBRA_SIGSTORE_URL=https://github.com/ZcashFoundation/zebra/releases/download/v6.3.0/SHA256SUMS.sigstore.json
ZEBRA_SIGSTORE_IDENTITY=https://github.com/ZcashFoundation/zebra/.github/workflows/zfnd-release-binaries.yml@refs/tags/v6.3.0
ZEBRA_SIGSTORE_ISSUER=https://token.actions.githubusercontent.com

# --- ports (127.0.0.1 only; away from the DERO simulator 20000/8089, app 8082, wallets 30000-30010, XSWD 44326) ---
MONERO_P2P_PORT=28080
MONERO_RPC_PORT=28081
MONERO_WALLET_RPC_PORT=28083
# a second wallet-rpc on the same daemon, so the two parties of a swap each have their own (a companion switches the
# rpc's open wallet as it works, so two companions cannot share one)
MONERO_WALLET_RPC_PORT2=28084
ZCASH_RPC_PORT=28232
ZCASH_P2P_PORT=28233

# Zcash TESTNET (public test network, outbound P2P only). Clients use the rpcgate port, which serves only zecswap's
# methods; zebrad's own RPC is on the internal port, with its cookie inside WSL's filesystem.
ZCASH_TESTNET_RPC_PORT=18232
ZCASH_TESTNET_ZEBRAD_RPC_PORT=18242
ZCASH_TESTNET_P2P_PORT=18233
ZCASH_TESTNET_GENESIS=05a60a92d99d85997cce3b87616c089f6124d7342af37106edc76126334a2c38
# a floor for the testnet tip in progress estimates: the last testnet checkpoint shipped in zebrad 6.3.0
# (test-checkpoints.txt). zebrad's estimatedheight undercounts testnet (3,568,918 at a fresh start, measured).
ZCASH_TESTNET_TIP_FLOOR=4238000

# Monero STAGENET (public test network, pruned, outbound P2P only): stagenet's own default ports, on loopback
STAGENET_RPC_PORT=38081
STAGENET_P2P_PORT=38080

# zebrad needs a miner address to start its block template; this one is the Zebra book's regtest example (a P2SH
# nobody here can spend). Funding goes through generatetoaddress to a key the harness holds, not through this.
ZCASH_DEFAULT_MINER=t27eWDgjFYJGVXmzrXeVjnb5J3uXDM9xH9v
