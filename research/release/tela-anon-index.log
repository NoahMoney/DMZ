# Part B: telainstall's own refusals (GAP-001, GAP-032)
== telainstall's refusals: none of these opens a wallet or sends a transaction; the mainnet lines contact no daemon
$ telainstall -network simulator -ringsize 2 -index f807075ff4a6ac27fc6c1a95923421afdadad72aeec85d2b04e035f3796d1bc3 -wallet $S/wallet21.db -password= -daemon 127.0.0.1:20000 -app $S/small/dist/simulator
WARNING: ring-2 INDEX: the installing wallet becomes its owner and can call UpdateCode for ever, replacing the whole app; that key stays a trusted party until it is destroyed, which nobody else can verify
INDEX f807075ff4a6ac27fc6c1a95923421afdadad72aeec85d2b04e035f3796d1bc3 was installed above ring 2: its owner is "anon" and UpdateCode refuses every caller. Install a new INDEX instead
exit 2

$ telainstall -network mainnet -yes -wallet x.db -app $S/small/dist/simulator -ringsize 2
mainnet: an INDEX installed at ring 2 is refused. Use -ringsize 16 (or more) for an INDEX nobody can update, or -ringsize 2 -updatable to accept that the installing key can replace the whole app for ever
exit 2

$ telainstall -network mainnet -yes -wallet x.db -app $S/small/dist/simulator -ringsize 8
mainnet: an INDEX installed at ring 8 is refused. Use -ringsize 16 (or more) for an INDEX nobody can update, or -ringsize 2 -updatable to accept that the installing key can replace the whole app for ever
exit 2

$ telainstall -network mainnet -yes -wallet x.db -app $S/small/dist/simulator
INDEX ring 16: its owner will be "anon" and UpdateCode will refuse every caller; a later release is a new INDEX
-app $S/small/dist/simulator is not a dist/mainnet bundle; build it with: cd tools && go run ./genconfig -dist -network mainnet, and pass -app ../dist/mainnet
exit 2

$ telainstall -network simulator -wallet x.db -app $S/small/dist/simulator -ringsize 16 -index f807075ff4a6ac27fc6c1a95923421afdadad72aeec85d2b04e035f3796d1bc3
-index updates an existing INDEX, and only a ring-2 INDEX can be updated: with -ringsize 16 each release is a new INDEX, so omit -index
exit 2

$ telainstall -network simulator -wallet x.db -app $S/small/dist/simulator -ringsize 16 -updatable
-updatable asks for a ring-2 INDEX, and -ringsize 16 installs one nobody can update: pass one or the other
exit 2

$ telainstall -network simulator -wallet x.db -app $S/small/dist/simulator -ringsize 12
ring sizes are powers of two from 2 to 128 (-ringsize 12, -doc-ringsize 2)
exit 2

$ telainstall -network simulator -wallet x.db -app $S/app
WARNING: ring-2 INDEX: the installing wallet becomes its owner and can call UpdateCode for ever, replacing the whole app; that key stays a trusted party until it is destroyed, which nobody else can verify
-app $S/app is not a dist/simulator bundle; build it with: cd tools && go run ./genconfig -dist -network simulator, and pass -app ../dist/simulator
exit 2

$ telainstall -network testnet -wallet x.db -app $S/small/dist/simulator
WARNING: ring-2 INDEX: the installing wallet becomes its owner and can call UpdateCode for ever, replacing the whole app; that key stays a trusted party until it is destroyed, which nobody else can verify
